<?php
/**
 * تقرير المرتجعات — يعرض كل عملية إرجاع (كاملة أو جزئية) مسجَّلة في النظام، مع المندوب المرتبط بفاتورتها
 * الأصلية، للمساعدة على مراجعة أي نمط متكرر (مندوب معيّن ترتفع لديه نسبة المرتجعات مثلاً).
 */
require_once 'header.php';

$filter_rep_id = intval($_GET['rep_id'] ?? 0);
$filter_from = $_GET['from'] ?? '';
$filter_to = $_GET['to'] ?? '';

$where = [];
$params = [];
if ($filter_rep_id > 0) { $where[] = "s.representative_id = ?"; $params[] = $filter_rep_id; }
if (!empty($filter_from)) { $where[] = "DATE(sr.created_at) >= ?"; $params[] = $filter_from; }
if (!empty($filter_to)) { $where[] = "DATE(sr.created_at) <= ?"; $params[] = $filter_to; }
$where_sql = count($where) > 0 ? ('WHERE ' . implode(' AND ', $where)) : '';

$stmt = $conn->prepare("
    SELECT sr.id AS return_id, s.invoice_number, s.customer_name,
           r.id AS representative_id, r.name AS representative_name,
           sr.total_amount_syp AS return_value_syp, COALESCE(sr.total_commission_reversed, 0) AS commission_reversed,
           s.invoice_date, sr.created_at AS return_date, s.total_amount_syp AS invoice_total_syp
    FROM sales_returns sr
    JOIN sales s ON sr.sale_id = s.id
    LEFT JOIN representatives r ON s.representative_id = r.id
    $where_sql
    ORDER BY sr.created_at DESC
");
$stmt->execute($params);
$returns = $stmt->fetchAll(PDO::FETCH_ASSOC);

// ملخّص مُجمَّع حسب المندوب — يكشف أي نمط متكرر بسرعة
$stmt_by_rep = $conn->prepare("
    SELECT COALESCE(r.name, 'بلا مندوب') AS representative_name,
           COUNT(*) AS returns_count,
           COALESCE(SUM(sr.total_amount_syp), 0) AS total_returned_syp,
           COALESCE(SUM(sr.total_commission_reversed), 0) AS total_commission_reversed
    FROM sales_returns sr
    JOIN sales s ON sr.sale_id = s.id
    LEFT JOIN representatives r ON s.representative_id = r.id
    $where_sql
    GROUP BY representative_name
    ORDER BY returns_count DESC
");
$stmt_by_rep->execute($params);
$by_rep = $stmt_by_rep->fetchAll(PDO::FETCH_ASSOC);

$reps_list = $conn->query("SELECT id, name FROM representatives ORDER BY name")->fetchAll(PDO::FETCH_ASSOC);
?>

