                        $cost_at_sale = floatval($stmt_cost->fetchColumn());
                        $items_data[] = ['product_id' => $p_id, 'qty' => $qty, 'price' => $price, 'total' => $item_total, 'cost_at_sale' => $cost_at_sale, 'comm_per_unit' => $comm_per_piece];
