                         ->execute([$sale_id, $it['product_id'], $it['qty'], $it['price'], $it['total'], $it['cost_at_sale'], $it['comm_per_unit']]);
                    $conn->prepare("UPDATE products SET current_quantity = current_quantity - ? WHERE id = ?")->execute([$it['qty'], $it['product_id']]);
                }

