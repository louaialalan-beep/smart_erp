            tbody.innerHTML = '<tr><td colspan="4" style="padding:15px; text-align:center; color:#777;">لا توجد كمية متاحة للإرجاع في هذه الفاتورة.</td></tr>';
        }
        document.getElementById('returnModal').style.display = 'flex';
    }

