                }
                if (count($items_data) == 0) { throw new Exception("يجب إدخال صنف واحد على الأقل."); }
                $total_usd = $new_exchange_rate > 0 ? ($total_syp / $new_exchange_rate) : 0;

                foreach ($items_data as $it) {
